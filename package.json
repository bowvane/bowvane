{
  "name": "bowvane",
  "productName": "Bowvane",
  "version": "0.1.0",
  "description": "Open-source browser that keeps Arc’s workflow alive — imports your Arc sidebar",
  "author": "Bowvane contributors",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && xvfb-run -a playwright test",
    "start": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "io.github.bowvane.bowvane",
    "productName": "Bowvane",
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": {
        "NSCameraUsageDescription": "Un site demande la caméra (visio).",
        "NSMicrophoneUsageDescription": "Un site demande le micro (visio)."
      }
    },
    "directories": {
      "output": "release"
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "electronVersion": "45.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  },
  "type": "module",
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.1"
  },
  "license": "MPL-2.0"
}
